#!/usr/bin/env bash
# Install Docker Engine and the Compose v2 plugin.
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/setup-common.sh
source "$BIN_DIR/lib/setup-common.sh"

setup_require_linux

if setup_check_docker_compose; then
  setup_info "docker compose already available: $(docker compose version)"
  exit 0
fi

setup_run_privileged true

if ! setup_has_command curl; then
  setup_info "curl not found — installing base packages first"
  "$BIN_DIR/install-packages"
fi

setup_info "Installing Docker Engine (get.docker.com)"
curl -fsSL https://get.docker.com | sh

if ! setup_check_docker_compose; then
  setup_die "docker compose still unavailable after install"
fi

setup_info "Docker installed: $(docker --version)"
setup_info "Compose installed: $(docker compose version)"

if [[ "$(id -u)" -ne 0 ]] && id -nG "$USER" 2>/dev/null | grep -qv docker; then
  setup_warn "add your user to the docker group: sudo usermod -aG docker $USER"
fi
